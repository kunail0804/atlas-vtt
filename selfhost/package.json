{
  "name": "atlas-selfhost",
  "private": true,
  "type": "module",
  "description": "Self-hosted relay and player page for the Atlas VTT fork.",
  "scripts": {
    "relay": "node --watch --disable-warning=MODULE_TYPELESS_PACKAGE_JSON relay/server.ts",
    "player:dev": "vite --config player/vite.config.mts",
    "player:build": "vite build --config player/vite.config.mts",
    "start": "npm run player:build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON relay/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
